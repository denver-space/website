---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import PricingCard from "@components/pricing.astro";

const pricing = [
  {
    name: "Bitcoiner",
    price: {
      monthly: "$150/mo",
      annual: "$1800",
      discount: "0%",
      original: "$150",
    },
    popular: true,
    features: [
    "Bring a Guest to Foundation Events & Activities",
    "Vote in Board Elections",
    "Private Voting Member Events",
    "Community Leadership Opportunities",
    "Contribute to our Educational Mission",
    ],
    button: {
      text: "Apply for Membership",
      link: "/membership-application",
    },
  }
];
---

<Layout title="Pricing">
  <!-- Upper Section with White Background -->
  <div class="bg-white ">
    <Container>
      <Sectionhead>
        <Fragment slot="title">Membership</Fragment>
        <Fragment slot="desc"> What do you do in The Space? <br/>
        </Fragment>
      </Sectionhead>
      <div class="grid gap-6 mx-auto max-w-2xl mt-12 mb-12 items-stretch h-full justify-center">
        <PricingCard plan={pricing[0]} />
      </div>
      
    </Container>
  </div>

</Layout>
